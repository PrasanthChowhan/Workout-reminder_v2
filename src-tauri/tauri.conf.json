{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kodon",
  "version": "0.1.3",
  "identifier": "com.prash.kodon",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Kodon",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRDNDIyNTQ0Q0U2NEMxNTcKUldSWHdXVE9SQ1ZDVEFiUm1kR05QZWhPbzVFblEvQU5hVnlabUtoUEtQSDFzbHVqQzBuVExuV24K",
      "endpoints": [
        "https://github.com/PrasanthChowhan/Workout-reminder_v2/releases/latest/download/latest.json"
      ]
    }
  }
}
